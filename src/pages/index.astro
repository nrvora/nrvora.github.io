---
import Base from '../layouts/Base.astro';
import { PERSON } from '../consts';

const featuredWorks = [
  {
    id: 'qubicml',
    slug: 'qubicml-fpga-quantum-state-discrimination',
    title: 'QubiCML',
    subtitle: 'Real-time quantum state discrimination on FPGA',
    venue: 'IEEE QCE 2024',
    stat: '54ns',
  },
  {
    id: 'dronechase',
    slug: 'dronechase-cross-modality-drone-tracking',
    title: 'DroneChase',
    subtitle: 'Cross-modality UAV tracking system',
    venue: 'ACM MobiSys 2023',
    stat: '+26%',
  },
  {
    id: 'signal',
    slug: 'physiological-signal-compression-headwear',
    title: 'Signal Compression',
    subtitle: 'Edge-efficient physiological sensing',
    venue: 'arXiv 2023',
    stat: '<1W',
  },
  {
    id: 'cryo',
    slug: 'cryogenic-accelerator-4k-quantum-state-discrimination',
    title: 'Cryo Accelerator',
    subtitle: 'ML inference at 4 Kelvin',
    venue: 'npj 2026',
    stat: '4K',
  },
];
---

<Base
  title={`${PERSON.name} — Quantum Control · AI on Edge · Accelerators`}
  description="Building intelligent computing systems at the boundary between algorithms and hardware."
>
  <div class="landing">
    <!-- Full-screen Hero with Immersive Graphic -->
    <section class="hero">
      <div class="hero-bg">
        <canvas id="pond" aria-hidden="true"></canvas>
      </div>

      <script>
        // The screen is a pond. One source drops a pulse every few seconds;
        // the wave physically displaces the dot grid and lights each dot by
        // the local surface slope, so the ripple reads as a 3D deformation
        // rather than drawn circles.
        const canvas = document.getElementById('pond') as HTMLCanvasElement;
        const ctx = canvas.getContext('2d')!;

        const SPACING = 26;          // grid pitch, px
        const SPEED = 170;           // wave speed, px/s
        const PERIOD = 2600;         // ms between drops
        const WIDTH_SIGMA = 34;      // radial thickness of the wave packet
        const AMP = 11;              // max vertical amplitude, px
        const SRC = { x: 0.72, y: 0.46 }; // source, as a fraction of the hero

        let w = 0, h = 0, dpr = 1;
        let dots: { x: number; y: number }[] = [];
        let waves: number[] = []; // birth timestamps

        function resize() {
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          w = canvas.offsetWidth;
          h = canvas.offsetHeight;
          canvas.width = w * dpr;
          canvas.height = h * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          dots = [];
          for (let y = SPACING / 2; y < h + SPACING; y += SPACING) {
            for (let x = SPACING / 2; x < w + SPACING; x += SPACING) {
              dots.push({ x, y });
            }
          }
        }

        // Wave height and radial slope at distance d from the source, for a
        // packet born `age` ms ago. Amplitude decays as it spreads (~1/√r).
        function surface(d: number, age: number) {
          const R = (age / 1000) * SPEED;
          const u = (d - R) / WIDTH_SIGMA;
          if (u * u > 9) return { z: 0, slope: 0 };
          const envelope = Math.exp(-u * u / 2);
          const spread = 1 / Math.sqrt(1 + R / 120);
          const life = Math.max(0, 1 - age / 9000);
          const a = AMP * envelope * spread * life;
          // One full oscillation across the packet: crest leading, trough trailing
          const z = a * Math.cos(u * 2.2);
          const slope = (-a * Math.sin(u * 2.2) * 2.2) / WIDTH_SIGMA;
          return { z, slope };
        }

        let last = -Infinity;
        function frame(now: number) {
          if (now - last > PERIOD) {
            waves.push(now);
            last = now;
          }
          waves = waves.filter((t) => now - t < 9000);

          const sx = w * SRC.x, sy = h * SRC.y;
          ctx.clearRect(0, 0, w, h);

          for (const dot of dots) {
            const dx = dot.x - sx, dy = dot.y - sy;
            const d = Math.hypot(dx, dy) || 0.001;
            let z = 0, slope = 0;
            for (const t of waves) {
              const s = surface(d, now - t);
              z += s.z;
              slope += s.slope;
            }
            // Displace radially by the surface height; light by slope, as if
            // lit from the source side: front face of the crest brightens.
            const px = dot.x + (dx / d) * z;
            const py = dot.y + (dy / d) * z - z * 0.5; // slight vertical lift
            const lit = Math.max(-1, Math.min(1, slope * 26));
            const alpha = 0.10 + Math.abs(z / AMP) * 0.45 + Math.max(0, lit) * 0.2;
            const r = 1 + Math.abs(z / AMP) * 1.6;
            ctx.beginPath();
            ctx.arc(px, py, r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(16, 23, 32, ${Math.min(alpha, 0.75)})`;
            ctx.fill();
          }

          // The source: dips as each pulse is born
          const phase = ((now - last) % PERIOD) / PERIOD;
          const srcR = 4 + 2 * Math.exp(-phase * 6);
          ctx.beginPath();
          ctx.arc(sx, sy, srcR, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(16, 23, 32, 0.9)';
          ctx.fill();

          requestAnimationFrame(frame);
        }

        resize();
        window.addEventListener('resize', resize);

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          // Static grid only
          for (const dot of dots) {
            ctx.beginPath();
            ctx.arc(dot.x, dot.y, 1, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(16, 23, 32, 0.1)';
            ctx.fill();
          }
        } else {
          requestAnimationFrame(frame);
        }
      </script>

      <!-- Hero Content Overlay -->
      <div class="hero-content">
        <div class="shell">
          <div class="hero-text">
            <p class="hero-affiliation">{PERSON.affiliation}</p>
            <h1 class="hero-name">Neel R. Vora</h1>
            <p class="hero-tagline">
              Machine learning that runs where the physics happens
            </p>
            <div class="hero-domains">
              <span class="domain">Quantum Control</span>
              <span class="domain">AI on Edge</span>
              <span class="domain">Accelerators</span>
            </div>
          </div>
        </div>
      </div>

    </section>

    <!-- Featured Works -->
    <section class="works">
      <div class="shell">
        <h2 class="section-title">Featured Research</h2>

        <div class="works-grid">
          {featuredWorks.map((work) => (
            <a href={`/publications/${work.slug}`} class="work-card">
              <div class="work-meta">
                <span class="work-venue">{work.venue}</span>
                <h3 class="work-title">{work.title}</h3>
                <p class="work-sub">{work.subtitle}</p>
                <span class="work-stat">{work.stat}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Links -->
    <section class="links">
      <div class="shell">
        <div class="links-row">
          <a href="/research" class="link-card">Research →</a>
          <a href="/publications" class="link-card">Publications →</a>
          <a href="/synseis" class="link-card">Synseis →</a>
          <a href="https://scholar.google.com/citations?user=EV0TOzcAAAAJ" class="link-card">Scholar →</a>
          <a href="https://github.com/nrvora" class="link-card">GitHub →</a>
          <a href="mailto:nrvora@lbl.gov" class="link-card">Contact →</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .landing {
    --accent: var(--ink);
  }

  /* Hero - Full bleed graphic */
  .hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #pond {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero-text {
    max-width: 600px;
  }

  .hero-affiliation {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 1rem;
  }

  .hero-name {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }

  .hero-tagline {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    color: var(--ink-soft);
    margin: 0 0 1.5rem;
    line-height: 1.4;
  }

  .hero-domains {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .domain {
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    padding: 0.5rem 1rem;
    border-radius: 2rem;
  }

  .scroll-cue {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--ink-soft);
    animation: bounce 2s ease-in-out infinite;
  }

  .scroll-cue svg {
    width: 28px;
    height: 28px;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(10px); }
  }

  /* Works Section */
  .works {
    padding: 6rem 0;
    background: var(--paper);
  }

  .section-title {
    font-size: 1.5rem;
    margin-bottom: 2rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 55rem) {
    .works-grid { grid-template-columns: 1fr; }
  }

  .work-card {
    display: block;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.3s;
  }

  .work-card:hover {
    border-color: var(--ink);
    transform: translateY(-4px);
    box-shadow: 0 16px 48px -12px rgba(16, 23, 32, 0.15);
  }

  .work-meta {
    padding: 1.5rem;
  }

  .work-venue {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .work-title {
    font-size: 1.35rem;
    margin: 0.25rem 0;
    color: var(--ink);
  }

  .work-sub {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .work-stat {
    display: inline-block;
    margin-top: 0.75rem;
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--ink);
  }

  /* Links Section */
  .links {
    padding: 4rem 0;
    background: var(--paper-raised);
    border-top: 1px solid var(--rule);
  }

  .links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .link-card {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .link-card:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue, .state-vector, .state-point, .radar-sweep, .ecg, .chip-core, .fpga-cells rect, .frost circle { animation: none; }
  }
</style>
